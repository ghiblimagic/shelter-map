<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:sys="clr-namespace:System;assembly=mscorlib"
>
  <!-- Legend swatch dimensions -->
  <sys:Double x:Key="LegendSwatchSize">16</sys:Double>
  <sys:Double x:Key="LegendSubSwatchSize">12</sys:Double>
  <Thickness x:Key="LegendSwatchMargin">0,0,8,0</Thickness>
  <Thickness x:Key="LegendSubSwatchMargin">0,0,6,0</Thickness>
  <Thickness x:Key="LegendRowMargin">0,2,0,2</Thickness>
  <Thickness x:Key="LegendSubRowMargin">20,2,0,2</Thickness>

  <!-- Pie chart constants -->
  <sys:Double x:Key="PieBaseRadius">20</sys:Double>
  <sys:Double x:Key="PieRadiusPerAnimal">25</sys:Double>
  <!-- divides Total -->
  <sys:Double x:Key="SliceLabelLeaderLength">15</sys:Double>
  <sys:Double x:Key="SliceLabelOffset">22</sys:Double>

  <!-- Circle map marker constants -->
  <sys:Double x:Key="CircleBaseRadius">10</sys:Double>
  <sys:Double x:Key="CircleRadiusPerAnimal">20</sys:Double>
  <!-- divides Total -->
</ResourceDictionary>
